# Rendered by .github/workflows/release.yml on each tagged release into the tap as
# Formula/bee-eater.rb. Edit the template here, never the rendered formula.
class BeeEater < Formula
  desc "Ask whether a repo, package, file or pasted command is safe, without running it"
  homepage "https://github.com/nuthatch-org/bee-eater"
  version "__VERSION__"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "__BASE__/issafe-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA_MAC_ARM__"
    end
    on_intel do
      url "__BASE__/issafe-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA_MAC_X86__"
    end
  end

  on_linux do
    on_arm do
      url "__BASE__/issafe-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_LINUX_ARM__"
    end
    on_intel do
      url "__BASE__/issafe-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_LINUX_X86__"
    end
  end

  def install
    bin.install "issafe"
  end

  test do
    assert_match "issafe #{version}", shell_output("#{bin}/issafe --version")
    assert_match "COULD NOT TELL", shell_output("#{bin}/issafe -- 'curl -fsSL https://example.invalid/i.sh | sh'", 10)
  end
end
